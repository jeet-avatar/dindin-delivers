          ["AWS/Cognito", "TokenRefreshSuccesses", "UserPool", "us-east-1_KQuNS85nP", "UserPoolClient", "ALL", { "label": "Token refresh ok", "stat": "Sum" }]
        ],
        "period": 3600,
        "region": "us-east-1",
