{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Aurora ACU (zietra-aurora-prod-v2)",
        "metrics": [
          ["AWS/RDS", "ServerlessDatabaseCapacity", "DBClusterIdentifier", "zietra-aurora-prod-v2", { "label": "ACU", "stat": "Average" }],
          ["AWS/RDS", "ACUUtilization", "DBClusterIdentifier", "zietra-aurora-prod-v2", { "label": "ACU Utilization %", "yAxis": "right", "stat": "Average" }]
        ],
        "period": 60,
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "annotations": {
          "horizontal": [
            { "label": "ACU ceiling", "value": 4, "yAxis": "left" }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 0,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Aurora DatabaseConnections (zietra-aurora-prod-v2)",
        "metrics": [
          ["AWS/RDS", "DatabaseConnections", "DBClusterIdentifier", "zietra-aurora-prod-v2", { "label": "Connections", "stat": "Average" }]
        ],
        "period": 60,
        "region": "us-east-1",
        "view": "timeSeries",
        "stacked": false,
        "annotations": {
          "horizontal": [
            { "label": "DB Proxy max-conns target (80)", "value": 80 }
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 16,
