# Dollor.ai Location Service - Environment Variables

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dollor

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=300  # Cache TTL in seconds (5 minutes)

# Geocoding Configuration
GEOCODING_USER_AGENT=dollor-ai-location-service

# Service Area Configuration (San Francisco Bay Area example)
SERVICE_AREA_CENTER_LAT=37.7749
SERVICE_AREA_CENTER_LON=-122.4194
SERVICE_AREA_RADIUS_KM=50

# Delivery Settings
MAX_DELIVERY_RADIUS_KM=10
AVERAGE_SPEED_KMH=40  # Average delivery speed in km/h

# Service Configuration
SERVICE_PORT=8007
SERVICE_NAME=location-service
SERVICE_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
