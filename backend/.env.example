# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Coupa Configuration (Optional)
COUPA_API_URL=https://your-instance.coupahost.com/api
COUPA_API_KEY=your-coupa-api-key-here

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AWS S3 Configuration (Optional - for invoice PDFs)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=doordash-p2p-invoices
AWS_REGION=us-east-1

# Platform Configuration
PLATFORM_FEE_RATE=0.15
TAX_RATE=0.08
DELIVERY_FEE=5.99

# Demo Account Credentials (for App Store review)
# These should be set in production for demo login endpoints
DEMO_ADMIN_EMAIL=support@dollor.ai
DEMO_ADMIN_PASSWORD=change-this-secure-password
DEMO_VENDOR_EMAIL=demobusiness@dollor.ai
DEMO_VENDOR_PASSWORD=change-this-secure-password
DEMO_CUSTOMER_EMAIL=demo.customer@dollor.ai
DEMO_CUSTOMER_PASSWORD=change-this-secure-password
DEMO_DRIVER_EMAIL=demo.driver@dollor.ai
DEMO_DRIVER_PASSWORD=change-this-secure-password
DEMO_RESTAURANT_EMAIL=demo.restaurant@dollor.ai
DEMO_RESTAURANT_PASSWORD=change-this-secure-password
