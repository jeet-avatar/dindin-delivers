# Phase 54.5 cutover env file (SANITIZED — committed to git)
#
# Source this file, then resolve MASTER_PW fresh from Secrets Manager:
#
#   source aurora-cutover.env
#   MASTER_PW=$(aws secretsmanager get-secret-value --secret-id "$MASTER_SECRET_ARN" \
#     --query SecretString --output text --region us-east-1 | jq -r .password)
#   ENC_PW=$(printf '%s' "$MASTER_PW" | jq -sRr @uri)
#   AURORA_URL="postgres://zietra_admin:${ENC_PW}@${WRITER}:5432/zietra"
#
# This env file is the operator handoff for plans 54.5-02 (dump/restore dry-run),
# 54.5-03 (cutover + SG hardening), and 54.5-04 (Lambda env-var flip).

# --- AWS account / region ---
export AWS_ACCOUNT=134607809447
export AWS_REGION=us-east-1

# --- Networking (created in 54.5-01 Task 1) ---
export DEFAULT_VPC=vpc-019418bb8d484ad8c
export SG_ID=sg-0760238c408d0f2b7
export DB_SUBNET_GROUP=zietra-aurora-subnets

# --- Aurora cluster (created in 54.5-01 Task 2) ---
export CLUSTER_ID=zietra-aurora-prod
export CLUSTER_ARN=arn:aws:rds:us-east-1:134607809447:cluster:zietra-aurora-prod
export WRITER=zietra-aurora-prod.cluster-c23qcukqe810.us-east-1.rds.amazonaws.com
export READER=zietra-aurora-prod.cluster-ro-c23qcukqe810.us-east-1.rds.amazonaws.com
export DB_NAME=zietra
export MASTER_USER=zietra_admin

# --- Master credential (auto-managed by Secrets Manager) ---
export MASTER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:134607809447:secret:rds!cluster-8dac9fc2-9172-4e70-a167-9fe6fe9e98d9-VbuP4h
export MASTER_PW=<resolve-via-secrets-manager>
export ENC_PW=<derive-from-MASTER_PW>
export AURORA_URL=postgres://zietra_admin:<ENC_PW>@zietra-aurora-prod.cluster-c23qcukqe810.us-east-1.rds.amazonaws.com:5432/zietra

# --- Encryption ---
export KMS_KEY_ID=arn:aws:kms:us-east-1:134607809447:key/1086212a-cf06-41ca-8767-514b2b18a008

# --- Source Supabase pooler (for 54.5-02 pg_dump) ---
# Resolve SUPA_PW from Supabase dashboard or whatever secret holds it (NOT stored in AWS Secrets Manager).
export SUPA_HOST=aws-1-us-east-2.pooler.supabase.com
export SUPA_PORT=5432
export SUPA_USER=postgres.lbpkbpfwdpnwlccmlfxn
export SUPA_DB=postgres
export SUPA_URL_DUMP='postgres://postgres.lbpkbpfwdpnwlccmlfxn:<SUPA_PW>@aws-1-us-east-2.pooler.supabase.com:5432/postgres'

