# -- REQUIRED ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your-64-char-hex-secret-here

# License key from TechCloudPro
LICENSE_KEY=your-license-key-here

# SMTP for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-app-password

# URL where users access ArthaBuild (for password reset links)
FRONTEND_BASE_URL=https://your-arthaBuild-domain.com

# -- OPTIONAL (defaults work for Docker Compose) --------------------------------
DATABASE_URL=sqlite+aiosqlite:////app/data/arthaBuild.db
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
FAISS_PATH=/app/data/vectorstore_ollama
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- PHASE 7 (License server) --------------------------------------------------
LICENSE_SERVER_URL=https://your-license-server.com
SALES_EMAIL=sales@example.com

# -- PHASE 8.1 (Tunable license config) ----------------------------------------
GRACE_PERIOD_HOURS=72
CACHE_TTL_DAYS=7

# -- CORS (additional allowed origins beyond ALLOWED_ORIGINS) --------------------
CORS_EXTRA_ORIGINS=
