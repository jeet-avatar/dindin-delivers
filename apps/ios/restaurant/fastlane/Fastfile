# Fastfile for Dollor Restaurant App (iOS) - STAGING ONLY
default_platform(:ios)

platform :ios do
  before_all do
    ensure_xcode_version(version: "16.1")
  end

  desc "Build and upload to TestFlight (Staging)"
  lane :beta do
    # Install dependencies
    cocoapods(
      podfile: "./Podfile",
      try_repo_update_on_error: true
    )

    # Build number is managed manually in project.pbxproj
    # To bump: sed -i '' 's/CURRENT_PROJECT_VERSION = X;/CURRENT_PROJECT_VERSION = Y;/g' eatffairrestaurant.xcodeproj/project.pbxproj
    # Only override if CI_BUILD_NUMBER is explicitly set
    if ENV["CI_BUILD_NUMBER"]
      increment_build_number(
        build_number: ENV["CI_BUILD_NUMBER"],
        xcodeproj: "eatffairrestaurant.xcodeproj"
      )
    end

    # Build the app
    build_app(
      workspace: "eatffairrestaurant.xcworkspace",
      scheme: "eatffairrestaurant",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "DollorRestaurant.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("✅ Successfully uploaded to TestFlight!")
  end

  error do |lane, exception|
    UI.error("❌ Error in lane '#{lane}': #{exception.message}")
  end
end
