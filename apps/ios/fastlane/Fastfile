# Fastfile - Fastlane lanes for Dollor iOS apps
# Production account: support@dollor.ai

default_platform(:ios)

platform :ios do

  # ==================== API KEY SETUP ====================

  desc "Setup App Store Connect API Key from environment"
  private_lane :setup_api_key do
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_KEY_ID']}.p8"),
        in_house: false
      )
    end
  end

  # ==================== MATCH LANES ====================

  desc "Sync all app store certificates and profiles"
  lane :sync_appstore_certs do
    setup_api_key
    match(
      type: "appstore",
      app_identifier: ["com.dollorai.customer", "com.dollorai.restaurant", "com.dollorai.delivery"],
      readonly: is_ci
    )
  end

  # ==================== CUSTOMER APP ====================

  desc "Build Customer app for TestFlight"
  lane :customer_testflight do
    setup_api_key
    match(
      type: "appstore",
      app_identifier: "com.dollorai.customer",
      readonly: is_ci
    )

    build_app(
      workspace: "customer/eatfaircustomer.xcworkspace",
      scheme: "eatfaircustomer",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "DollorCustomer.ipa",
      clean: true,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=PRKZ4UVCD7 CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.dollorai.customer'"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "build/DollorCustomer.ipa"
    )
  end

  # ==================== RESTAURANT APP ====================

  desc "Build Restaurant app for TestFlight"
  lane :restaurant_testflight do
    setup_api_key
    match(
      type: "appstore",
      app_identifier: "com.dollorai.restaurant",
      readonly: is_ci
    )

    build_app(
      workspace: "restaurant/eatffairrestaurant.xcworkspace",
      scheme: "eatffairrestaurant",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "DollorRestaurant.ipa",
      clean: true,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=PRKZ4UVCD7 CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.dollorai.restaurant'"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "build/DollorRestaurant.ipa"
    )
  end

  # ==================== DRIVER/DELIVERY APP ====================

  desc "Build Driver app for TestFlight"
  lane :driver_testflight do
    setup_api_key
    match(
      type: "appstore",
      app_identifier: "com.dollorai.delivery",
      readonly: is_ci
    )

    build_app(
      workspace: "delivery/eatffairdelivery.xcworkspace",
      scheme: "eatffairdelivery",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "DollorDriver.ipa",
      clean: true,
      xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=PRKZ4UVCD7 CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore com.dollorai.delivery'"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "build/DollorDriver.ipa"
    )
  end

  # ==================== ALL APPS ====================

  desc "Deploy all apps to TestFlight"
  lane :all_testflight do
    customer_testflight
    restaurant_testflight
    driver_testflight
  end

end
