# Fastfile - Fastlane lanes for Dollor iOS apps

default_platform(:ios)

platform :ios do

  # ==================== API KEY SETUP ====================

  desc "Setup App Store Connect API Key from environment"
  private_lane :setup_api_key do
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_KEY_ID']}.p8"),
        in_house: false
      )
    end
  end

  # ==================== MATCH LANES ====================

  desc "Sync all development certificates and profiles"
  lane :sync_dev_certs do
    setup_api_key
    match(
      type: "development",
      app_identifier: ["com.dollorai.customer", "com.dollorai.restaurant", "com.dollorai.delivery"],
      readonly: is_ci
    )
  end

  desc "Sync all app store certificates and profiles"
  lane :sync_appstore_certs do
    setup_api_key
    match(
      type: "appstore",
      app_identifier: ["com.dollorai.customer", "com.dollorai.restaurant", "com.dollorai.delivery"],
      readonly: is_ci
    )
  end

  # ==================== CUSTOMER APP ====================

  desc "Build Customer app for development"
  lane :customer_dev do
    sync_dev_certs
    Dir.chdir("customer") do
      build_app(
        workspace: "eatfaircustomer.xcworkspace",
        scheme: "eatfaircustomer",
        configuration: "Debug",
        export_method: "development",
        output_directory: "build",
        output_name: "DollorCustomer-Dev.ipa"
      )
    end
  end

  desc "Build Customer app for TestFlight"
  lane :customer_testflight do
    setup_api_key
    sync_appstore_certs
    Dir.chdir("customer") do
      build_app(
        workspace: "eatfaircustomer.xcworkspace",
        scheme: "eatfaircustomer",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        output_name: "DollorCustomer.ipa"
      )
    end
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "customer/build/DollorCustomer.ipa"
    )
  end

  # ==================== RESTAURANT APP ====================

  desc "Build Restaurant app for development"
  lane :restaurant_dev do
    sync_dev_certs
    Dir.chdir("restaurant") do
      build_app(
        workspace: "eatffairrestaurant.xcworkspace",
        scheme: "eatffairrestaurant",
        configuration: "Debug",
        export_method: "development",
        output_directory: "build",
        output_name: "DollorRestaurant-Dev.ipa"
      )
    end
  end

  desc "Build Restaurant app for TestFlight"
  lane :restaurant_testflight do
    setup_api_key
    sync_appstore_certs
    Dir.chdir("restaurant") do
      build_app(
        workspace: "eatffairrestaurant.xcworkspace",
        scheme: "eatffairrestaurant",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        output_name: "DollorRestaurant.ipa"
      )
    end
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "restaurant/build/DollorRestaurant.ipa"
    )
  end

  # ==================== DRIVER APP ====================

  desc "Build Driver app for development"
  lane :driver_dev do
    sync_dev_certs
    Dir.chdir("delivery") do
      build_app(
        workspace: "eatffairdelivery.xcworkspace",
        scheme: "eatffairdelivery",
        configuration: "Debug",
        export_method: "development",
        output_directory: "build",
        output_name: "DollorDriver-Dev.ipa"
      )
    end
  end

  desc "Build Driver app for TestFlight"
  lane :driver_testflight do
    setup_api_key
    sync_appstore_certs
    Dir.chdir("delivery") do
      build_app(
        workspace: "eatffairdelivery.xcworkspace",
        scheme: "eatffairdelivery",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        output_name: "DollorDriver.ipa"
      )
    end
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      ipa: "delivery/build/DollorDriver.ipa"
    )
  end

  # ==================== ALL APPS ====================

  desc "Build all apps for development"
  lane :all_dev do
    customer_dev
    restaurant_dev
    driver_dev
  end

  desc "Deploy all apps to TestFlight"
  lane :all_testflight do
    customer_testflight
    restaurant_testflight
    driver_testflight
  end

end
