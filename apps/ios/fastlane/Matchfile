# Matchfile - Fastlane Match configuration for certificate/profile sync
# Production account: support@dollor.ai

git_url("https://github.com/jeet-avatar/ios-certificates.git")
git_branch("main")
storage_mode("git")

# Type: appstore for production release
type("appstore")

# App identifiers for Dollor apps
app_identifier([
  "com.dollorai.customer",
  "com.dollorai.restaurant",
  "com.dollorai.delivery"
])

# Apple Developer Account
username("support@dollor.ai")
team_id("PRKZ4UVCD7")

# For CI - read only mode
readonly(is_ci)

# Force for new devices
force_for_new_devices(true)
