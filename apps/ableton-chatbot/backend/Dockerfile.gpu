# BeatMind Cloud HQ separation job for AWS Batch GPU instances (NVIDIA driver provided by the host AMI).
# Build: docker buildx build --platform linux/amd64 -f Dockerfile.gpu -t musai-api:beatmind-gpu-<sha> .
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-reference.txt ./
RUN pip install --no-cache-dir torch==2.5.1+cu124 torchaudio==2.5.1+cu124 --index-url https://download.pytorch.org/whl/cu124 \
    && pip install --no-cache-dir -r requirements-reference.txt

# Ship weights in the image; jobs must not download models.
ENV TORCH_HOME=/opt/beatmind-models
ARG DRUMSEP_SHA256=aefaa8543c9b9c75e22f5f32b53ab86dfe416457849af1383ff1aef83401423f
RUN python -c "from demucs.pretrained import get_model; get_model('htdemucs_ft')" \
    && curl -fsSL https://www.beatmind.io/models/drumsep-49469ca8.th -o /opt/beatmind-models/drumsep-49469ca8.th \
    && echo "${DRUMSEP_SHA256}  /opt/beatmind-models/drumsep-49469ca8.th" | sha256sum -c - \
    && chmod -R a+rX /opt/beatmind-models

RUN groupadd -g 1000 appgroup && useradd -u 1000 -g appgroup appuser
COPY . .
USER appuser

ENV DEMUCS_MODEL=htdemucs_ft
ENV DEMUCS_DEVICE=cuda
ENV DEMUCS_SHIFTS=2
ENV DEMUCS_OVERLAP=0.5
ENV BEATMIND_DRUMSEP_CHECKPOINT=/opt/beatmind-models/drumsep-49469ca8.th
ENV BEATMIND_REQUIRE_CACHED_MODEL=1
ENV BEATMIND_TORCH_THREADS=4
ENV NUMBA_CACHE_DIR=/tmp/beatmind-numba

CMD ["python", "cloud_job.py"]
