# Claude AI
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Plans and packs are found by Stripe price lookup key (catalog.py); no price IDs are configured here.
STRIPE_PORTAL_CONFIGURATION=bpc_...   # BeatMind's own Customer Portal configuration

# Billing (see billing.py / ai_usage.py). Metering turns on once the Stripe catalog resolves.
BILLING_ENFORCED=                  # false = kill-switch (unmetered); true = force on
BILLING_PAST_DUE_GRACE_DAYS=7      # past_due keeps access this long after the first failed renewal
MIXMIND_SALES_ENABLED=false        # MixMind plan and combos stay "coming soon" until true
TRIAL_INCLUDED_TRACKS=3            # no-card app trial: tracks separated on the user's computer
TRIAL_INCLUDED_CLOUD=0
TRIAL_CHAT_MESSAGES=50             # trial AI cap (always enforced)
TRIAL_AI_USD=3
AI_FAIR_USE_ENFORCED=true          # paid-plan monthly AI cap; false = log only
AI_FAIR_USE_USD_STARTER=12
AI_FAIR_USE_USD_PRO=20
AI_FAIR_USE_USD_STUDIO=40
# MixMind desktop AI proxy (/api/mixmind/ai/v1/messages, mixmind_ai.py): Claude on Bedrock us-east-1 via the task role.
MIXMIND_AI_FAIR_USE_ENFORCED=true  # monthly MixMind AI cap; false = log only
MIXMIND_AI_CAP_USD=12              # estimated USD per user per UTC month (feature 'mixmind' only)
MIXMIND_AI_READ_TIMEOUT=180        # seconds; Bedrock read timeout for the proxy
# OpenAI cost estimates use PLACEHOLDER rates until all four are set from OpenAI's price list (USD per 1M tokens).
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_CACHED_INPUT_USD_PER_MTOK=
OPENAI_AUDIO_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=
# BEATMIND_INCLUDED_TRACKS=10      # only for subscribers from before plans existed (default Starter = 10)
# BEATMIND_PACKS=[...]             # optional override of the beatmind_pack_* catalog

# Auth
JWT_SECRET=change-this-to-a-random-string-in-production

# App
DB_PATH=beatmind.db
FRONTEND_URL=https://www.beatmind.io   # or http://localhost:3000 for dev

# Optional reference audio worker; requires requirements-reference.txt and FFmpeg.
# Preload htdemucs weights and provision persistent private storage before enabling.
BEATMIND_REFERENCE_ENABLED=0
BEATMIND_REFERENCES_DIR=/data/references

# Optional paid OpenAI excerpt listening; never exposed to the browser.
BEATMIND_AUDIO_LISTENING_ENABLED=0
BEATMIND_AUDIO_API_KEY=
BEATMIND_AUDIO_MODEL=gpt-audio-1.5
BEATMIND_TEMPLATE_MODEL=gpt-4.1
