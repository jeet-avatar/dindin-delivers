<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for PyInstaller sidecar: its bundled dylibs lack Apple signatures -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outbound HTTP: localhost sidecar API + https://api.beatmind.io -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Keychain access to persist auth token across app launches -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)io.beatmind.mixmind</string>
    </array>
</dict>
</plist>
