# Dollor.ai Backend Docker Ignore
# ================================

# Environment files (CRITICAL - never include secrets in image)
.env
.env.*
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
.Python
*.egg-info/
.eggs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Documentation
*.md
docs/

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*
.docker/

# Local uploads (handled separately in production)
uploads/

# Temporary files
*.log
*.tmp
tmp/
