# Required
JWT_SECRET_KEY=change-me-to-at-least-32-random-chars

# OpenAI (for GPT-4o extraction and drafting agent)
OPENAI_API_KEY=sk-...

# AWS (for S3 document storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=hospital-pricing-documents

# Database (auto-set by docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hospital_pricing

# Redis (auto-set by docker-compose)
REDIS_URL=redis://localhost:6379/0
